{
  "name": "cedh-simulator",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "build:decks": "node scripts/build-forge-decks.mjs",
    "audit:forge": "node scripts/audit-forge-support.mjs",
    "observe": "node scripts/capture-priority-observation.mjs",
    "probe:land": "node scripts/capture-priority-observation.mjs --play-land \"Command Tower\" --stage-into-hand \"Command Tower\"",
    "probe:land:staged-audit": "node scripts/capture-priority-observation.mjs --audit-only --stage-into-hand \"Steam Vents\"",
    "verify:choice-guard": "node scripts/verify-choice-refusal.mjs --mode guard --source \"Shatterskull Smashing\"",
    "verify:hook-fault": "node scripts/verify-choice-refusal.mjs --mode fault --source \"Shatterskull Smashing\"",
    "verify:spell-guard": "node scripts/verify-choice-refusal.mjs --mode spell --source \"Mox Amber\"",
    "probe:targeted": "node scripts/capture-priority-observation.mjs --cast-targeted-spell \"Lava Dart\" --mana-source \"Mountain\" --additional-mana-source \"Great Furnace\" --target-player-seat 2",
    "probe:mana-colour-exclusion": "node scripts/inspect-expansion.mjs --label mana-colour-exclusion --stage-hand \"Lava Dart\" --stage-battlefield \"Command Tower\" --expect-exclusion-for \"Command Tower\" --expect-no-expanded-for \"Lava Dart\"",
    "probe:copy-targets-exclusion": "node scripts/inspect-expansion.mjs --label copy-targets-exclusion --stage-hand \"Brain Freeze\" --stage-battlefield \"Mountain\" --stage-battlefield \"Great Furnace\" --expect-skipped spell-copy-targets-not-represented --expect-no-expanded-for \"Brain Freeze\"",
    "probe:floating-mana": "node scripts/inspect-expansion.mjs --label floating-mana --produce-mana \"Mountain\" --expect-suppressed floating-mana-not-supported --expect-attempted true",
    "capture:v3-natural": "node scripts/capture-priority-observation.mjs --output examples/priority-observation-v3.json",
    "capture:v3-targeted": "node scripts/capture-priority-observation.mjs --cast-targeted-spell \"Lava Dart\" --mana-source \"Mountain\" --additional-mana-source \"Great Furnace\" --target-player-seat 2 --before examples/targeted-spell-before-v3.json",
    "verify:enumeration-guard": "node scripts/verify-enumeration-guard.mjs",
    "simulate": "node scripts/run-forge-baseline.mjs",
    "simulate:dry": "node scripts/run-forge-baseline.mjs --dry-run"
  },
  "devDependencies": {
    "ajv": "8.20.0"
  }
}
